# --- core ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# --- database ---
DATABASE_URL=file:./linkbook.db

# --- single-user (v1, §5.5) ---
# Whoever signs in with this Google account is "the operator." In dev,
# principal.py returns this user without real OAuth.
DEV_PRINCIPAL_EMAIL=neel@flightdesign.co
DEV_PRINCIPAL_NAME=Neel

# --- studio config (§3.5, set during onboarding; hardcoded in dev) ---
STUDIO_NAME=Flight Design Co.
STUDIO_FISCAL_YEAR_START=01-01
STUDIO_BILLABLE_TARGET_PCT=70
STUDIO_LOADED_COST_RATE=85

# --- LLM cost runaway protector (§5.7) ---
LLM_DAILY_KILL_SWITCH_USD=20

# --- integration mocks (v1 dev; flip off when wiring real APIs) ---
USE_INTEGRATION_MOCKS=true

# Per-source live escape hatch — comma-separated source names that
# should hit real APIs even when USE_INTEGRATION_MOCKS=true. Lets you
# take one integration live (e.g. for a PoC) without flipping the whole
# system. Sources: qbo, harvest, dropboxsign, airtable, gmail.
INTEGRATION_LIVE_SOURCES=

# --- agent-driven action dispatch (§5.3) -----------------------------
# Flip to true to route action.execute through the Agentspan
# orchestrator. You also need EITHER:
#   - ANTHROPIC_API_KEY set (LLM goes direct), OR
#   - a running Agentspan server (AGENTSPAN_SERVER_URL).
# When off OR neither is configured, we lazy-fall-back to the manual
# dispatcher so the system still works.
USE_AGENT_DISPATCH=true

# Direct mode: just an Anthropic key. Runs in-process. Tools execute
# locally inside the API. NOT visible in the Agentspan UI.
ANTHROPIC_API_KEY=

# Server mode: agent runs go through the Agentspan server and ARE
# visible in the UI. Requires the worker too:
#     uv run linkbook-agent-worker
# Default local server is http://localhost:6767/api when you run
# `agentspan serve`.
AGENTSPAN_SERVER_URL=
AGENTSPAN_API_KEY=

# Model the orchestrator + sub-agents use. Defaults to claude-3-5-sonnet
# when ANTHROPIC_API_KEY is set; otherwise gpt-4o-mini. Override here.
AGENTSPAN_LLM_MODEL=

# --- 30s send-delay queue (§2.5). Tests override to 80ms. ---
SEND_DELAY_MS=30000

# --- ranking weights (§1.3, tunable from design-partner data) ---
RANK_W_MONEY=0.40
RANK_W_URGENCY=0.25
RANK_W_CLIENT_TIER=0.15
RANK_W_BLOCKING=0.10
RANK_W_NEGLECT=0.10
RANK_W_SNOOZED=0.50

# --- integrations (filled in per-source onboarding; blank in dev) ---
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REDIRECT_URI=
QBO_ENVIRONMENT=sandbox

HARVEST_CLIENT_ID=
HARVEST_CLIENT_SECRET=
HARVEST_REDIRECT_URI=

DROPBOXSIGN_CLIENT_ID=
DROPBOXSIGN_CLIENT_SECRET=
DROPBOXSIGN_API_KEY=

AIRTABLE_CLIENT_ID=
AIRTABLE_CLIENT_SECRET=
AIRTABLE_REDIRECT_URI=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_PUBSUB_TOPIC=
