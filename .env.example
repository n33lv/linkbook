# --- core ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# --- database (sqlite for v1; swap to postgres later) ---
DATABASE_URL=file:./linkbook.db

# --- single-user (v1) ---
# Whoever signs in with this Google account is "the operator." (§5.5)
# In dev, principal.ts returns this user without real OAuth.
DEV_PRINCIPAL_EMAIL=neel@flightdesign.co
DEV_PRINCIPAL_NAME=Neel

# --- studio config (§3.5, set during onboarding; hardcoded in dev) ---
STUDIO_NAME=Flight Design Co.
STUDIO_FISCAL_YEAR_START=01-01
STUDIO_BILLABLE_TARGET_PCT=70
STUDIO_LOADED_COST_RATE=85

# --- agents / Anthropic (§5.3) ---
ANTHROPIC_API_KEY=
AGENTSPAN_BASE_URL=
AGENTSPAN_API_KEY=

# --- LLM cost runaway protector (§5.7) ---
LLM_DAILY_KILL_SWITCH_USD=20

# --- integration mocks (v1 dev; flip off when wiring real APIs) ---
USE_INTEGRATION_MOCKS=true

# --- integrations (filled in per-source onboarding; blank in dev) ---
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REDIRECT_URI=http://localhost:3000/integrations/qbo/callback
QBO_ENVIRONMENT=sandbox

HARVEST_CLIENT_ID=
HARVEST_CLIENT_SECRET=
HARVEST_REDIRECT_URI=http://localhost:3000/integrations/harvest/callback

DROPBOXSIGN_CLIENT_ID=
DROPBOXSIGN_CLIENT_SECRET=
DROPBOXSIGN_API_KEY=

AIRTABLE_CLIENT_ID=
AIRTABLE_CLIENT_SECRET=
AIRTABLE_REDIRECT_URI=http://localhost:3000/integrations/airtable/callback

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/integrations/gmail/callback
GOOGLE_PUBSUB_TOPIC=

# --- ranking weights (§1.3, tunable from design-partner data) ---
RANK_W_MONEY=0.40
RANK_W_URGENCY=0.25
RANK_W_CLIENT_TIER=0.15
RANK_W_BLOCKING=0.10
RANK_W_NEGLECT=0.10
RANK_W_SNOOZED=0.50
