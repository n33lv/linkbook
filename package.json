{
  "name": "linkbook",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @linkbook/api dev",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @linkbook/db drizzle-kit generate",
    "db:migrate": "pnpm --filter @linkbook/db migrate",
    "db:studio": "pnpm --filter @linkbook/db drizzle-kit studio"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "@types/node": "^22.7.5"
  }
}
